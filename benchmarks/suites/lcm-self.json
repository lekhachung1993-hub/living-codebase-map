      "expected_files": ["scripts/living_map.py", "tests/test_symbol_index.py", "PROJECT_MAP.md"],
      "expected_symbols": ["py:scripts/living_map.py::scan_file_symbol_records", "py:scripts/living_map.py::build_symbol_index"],
      "expected_dependencies": ["py:scripts/living_map.py::build_symbol_index|CALLS|py:scripts/living_map.py::scan_file_symbol_records"],
      "expected_tests": ["tests/test_symbol_index.py"],
      "expected_constraints": []
    },
    {

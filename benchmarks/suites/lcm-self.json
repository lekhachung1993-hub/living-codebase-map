{
  "schema_version": 1,
  "name": "LCM self-maintenance v1",
  "description": "Repository-grounded tasks covering feature work, bug fixes, refactors, impact, history, verification, and release maintenance.",
  "tasks": [
    {
      "id": "context-budget",
      "category": "feature",
      "prompt": "Add a stricter token budget mode to task context compilation.",
      "acceptance_checks": ["context output stays within the requested budget", "existing and new unit tests pass"],
      "expected_files": ["scripts/living_map.py", "tests/test_symbol_index.py", "README.md"],
      "expected_symbols": ["py:scripts/living_map.py::compile_task_context", "py:scripts/living_map.py::cmd_context"],
      "expected_dependencies": ["py:scripts/living_map.py::cmd_context|CALLS|py:scripts/living_map.py::compile_task_context"],
      "expected_tests": ["tests/test_symbol_index.py"],
      "expected_constraints": []
    },
    {
      "id": "language-extractor",
      "category": "feature",
      "prompt": "Add stable ranged symbols for another source language.",
